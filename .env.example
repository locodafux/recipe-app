# Copy to .env.local (gitignored) to point the app at another Supabase project, e.g. the local stack
# (`supabase start` prints both values). Unset, the app uses the hosted project in src/remote.ts.
# Never put a secret/service_role key here: EXPO_PUBLIC_* values ship inside the app.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
